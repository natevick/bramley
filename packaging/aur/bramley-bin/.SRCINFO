pkgbase = bramley-bin
	pkgdesc = Small native player for Apple Music
	pkgver = 0.1.1
	pkgrel = 1
	url = https://github.com/natevick/bramley
	arch = x86_64
	license = MIT
	depends = glibc
	depends = google-chrome
	depends = hicolor-icon-theme
	depends = libgcc
	depends = libglvnd
	depends = libstdc++
	depends = libx11
	depends = libxcursor
	depends = libxi
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = libxrender
	depends = pulse-native-provider
	depends = wayland
	depends = xdg-utils
	optdepends = fontconfig: follow the desktop text hinting and antialiasing settings
	optdepends = gnome-keyring: keep the Apple Music sign-in in the Secret Service keyring; without one it is kept in a private file under ~/.config/bramley
