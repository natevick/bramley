pkgbase = bramley-bin
	pkgdesc = Small native player for Apple Music
	pkgver = 0.3.0
	pkgrel = 1
	url = https://github.com/natevick/bramley
	arch = x86_64
	license = MIT
	depends = glibc
	depends = google-chrome
	depends = hicolor-icon-theme
	depends = libgcc
	depends = libglvnd
	depends = libstdc++
	depends = libx11
	depends = libxcursor
	depends = libxi
	depends = libxkbcommon
	depends = libxkbcommon-x11
